# Local development defaults; run alembic upgrade head before starting the API.
RAG_DATABASE_URL=sqlite:///./rag_assistant.db
RAG_EMBEDDING_PROVIDER=deterministic
RAG_OPENAI_API_KEY=
RAG_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSIONS=128
RAG_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
